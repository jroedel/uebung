# Copy to deploy.env (which is gitignored) and fill in.
#
#     cp deploy/deploy.env.example deploy/deploy.env
#
# Everything that identifies the server lives here and only here, so deploy.sh
# itself is safe to commit. Values may also be supplied as environment
# variables, which is what a CI runner would do instead of a file.

# --- how to reach the server (required) ------------------------------------
SSH_HOST=
SSH_USER=
SSH_PORT=22

# --- where things go on the server ----------------------------------------
# The application directory is deliberately NOT inside the document root. A
# database under public_html is one broken .htaccess away from being
# downloadable, and uebung.db holds every account's address and their session
# hashes. Only .htaccess belongs in the docroot.
APP_DIR=~/uebung
DOCROOT=~/public_html/uebung.club

# The loopback port Apache proxies to. Nothing needs opening in the firewall:
# the app must never be reachable except through Apache's TLS.
APP_PORT=8402

# --- how the process is kept running --------------------------------------
# systemd  — `systemctl --user`, needs lingering enabled for the account
# nohup    — a PID-file supervisor plus an @reboot crontab entry
# Run `deploy/deploy.sh probe` to find out which this server supports.
SUPERVISOR=systemd

# --- public identity (not secret) -----------------------------------------
PUBLIC_URL=https://uebung.club
MAIL_FROM=hi@uebung.club
SMTP_HOST=dedi2934.your-server.de
SMTP_PORT=587
SMTP_USER=hi@uebung.club

# NOTE: the SMTP password is NOT set here and is never uploaded. It lives on the
# server in $APP_DIR/uebung.env as UEBUNG_SMTP_PASSWORD, created once by hand:
#
#     printf 'UEBUNG_SMTP_PASSWORD=%s\n' 'the-password' > ~/uebung/uebung.env
#     chmod 600 ~/uebung/uebung.env
#
# Keeping it out of the flags matters: command lines are visible in ps output to
# every other user on a shared machine.
