# Claude Code local, per-machine settings
**/.claude/settings.local.json
**/.claude/worktrees/

# Go
*.exe
*.test
*.out
coverage.*
/bin/
/dist/

# Local, per-machine working area: the unattended-resume script, its logs and its
# state. Deliberately untracked -- it hardcodes this machine's session id, uid and
# keyring socket, none of which are meaningful on another host. See
# docs/build-out-plan.md for how to recreate it.
local/

# Local env
.env
.env.local

# Deploy target: host, account and port. Deliberately untracked -- deploy.sh is
# committed, the identity of the machine it talks to is not.
deploy/deploy.env
deploy/.uebung-linux

# uebung runtime
/uebung
uebung.db
# SQLite's write-ahead log and shared-memory sidecars
uebung.db-wal
uebung.db-shm
*.tmp

# Database backups pulled off the server to rehearse a migration against. These
# are the real thing -- addresses, nicknames, every learner's history -- and this
# repository is public. The uebung.db rules above do NOT cover them: a backup is
# named uebung-<stamp>.db, so it matched nothing and sat one `git add -A` away
# from being published.
backups/

# Recovery bundles from a coworking session, kept out of the tree
*.bundle
*.bundle.txt
